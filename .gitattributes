# Text files are stored with LF line endings; the prebuilt libraries and images are binary
* text=auto eol=lf
*.a binary
*.so binary
*.img binary
*.jffs2 binary
*.bin binary
*.png binary
*.jpg binary
# Device files from V1.00, kept byte for byte: CRLF config files and a prebuilt tool
rootfs/skeleton/etc/ps_ir_*.conf -text whitespace=cr-at-eol
rootfs/skeleton/etc/format_tool binary
